#!/usr/bin/env python3
"""
Install the emiShielding model chain:

    dielectricFunction (QE)  →  emiShielding (Meep 1D)

Packages are installed to ~/.modena/models and registered in
~/.modena/config.toml so that "import modena" makes them importable.
"""

import subprocess
import sys
from pathlib import Path

APPS = Path(__file__).resolve().parent.parent.parent / 'applications'

subprocess.run(
    [sys.executable, '-m', 'modena', 'install',
     str(APPS / 'QuantumEspresso/dielectricFunction'),
     str(APPS / 'Meep/emiShielding'),
     ],
    check=True,
)
