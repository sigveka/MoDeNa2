# Exclude all files by default
**/*
# Include all directories and Explicitly include relevant file-types
!**/

# Scripting languages
!*.py
!*.m
!*.rb
!*.mat
!*.jl
!*.R
!*.r

# Misc
!*.svg
!*.gp
!*.gpl

# Compiled programming languages
!*.c
!*.h
!*.cpp
!*.C
!*.hpp
!*.H
!*.f
!*.F
!*.f90
!*.F90

# Document markup files
!*.md

# MkDocs and CI configuration
!mkdocs.yml
!.github/workflows/*.yml
!*.toml
# !*.txt
# !*.tex
# !*.bib
# !*.sty
# !*.cls
#

# Build system — CMake configuration and cmake/pip templates.  Without
# these the project cannot be built from a fresh clone; the allowlist
# pattern above would otherwise exclude them all.
!CMakeLists.txt
!CMakePresets.json
!*.cmake
!*.cmake.in
!*.py.in
!*.h.in
!*.sh.in
# Templates for the generated status-code bindings.  Each extension needs its
# own entry: the allowlist matches the FULL name, so `!*.py.in` does nothing
# for `fmodena_status.f90.in`.  Leaving these out silently produced a tree
# that could not be configured from a fresh clone.
!*.f90.in
!*.m.in
!*.R.in

# R package metadata.  Both are extensionless, so the allowlist excluded them
# and the R wrapper has never been installable from a clone -- R CMD INSTALL
# requires DESCRIPTION, and NAMESPACE declares useDynLib and the exports.
!DESCRIPTION
!NAMESPACE
!NAMESPACE.in

# Repo essentials that the allowlist would otherwise exclude
!.gitignore
!README.md
!install
!run_portal

# Example entry points.  These are extensionless executables, so the allowlist
# above excluded every one of them and no example was runnable from a fresh
# clone.
#
# Neither workflow.yaml nor FW_config.yaml is listed: FireWorks and
# `modena fw run --script` generate both on demand, so a committed copy is
# stale the moment anything changes.  `workflow` (no extension) below is the
# hand-written entry point and IS tracked.
!initModels
!buildModels
!workflow
!rerunSimulations
!Makefile

# One hand-authored exception to the workflow.yaml rule above.  This file is
# not FireWorks output -- it is a hand-written pisoFoam workflow (YAML anchors,
# a gmsh -> simpleFoam pipeline) with no "Auto-generated File" banner, and it
# was tracked from the first commit until the generated ones were cleaned up.
# NOTE: the rest of that case (case/, gmsh/, templates/, *.yaml configs) has
# never been tracked, so the case is still not reproducible from a clone.
!applications/OpenFoam/src/cases/pisoFoam/laminar/workflow.yaml


# Exclude
CLAUDE.md
.claude/
build/
site/
func_*/
launcher_*/
modena.log
models/

CMakeUserPresets.json
