# Exclude all files by default
**/*
# Include all directories and Explicitly include relevant file-types
!**/

# Scripting languages
!*.py
!*.m
!*.rb
!*.mat
!*.jl
!*.R
!*.r

# Misc
!*.svg
!*.gp
!*.gpl

# Compiled programming languages
!*.c
!*.h
!*.cpp
!*.C
!*.hpp
!*.H
!*.f
!*.F
!*.f90
!*.F90

# Document markup files
!*.md

# MkDocs and CI configuration
!mkdocs.yml
!.github/workflows/*.yml
!*.toml
# !*.txt
# !*.tex
# !*.bib
# !*.sty
# !*.cls
#

# Build system — CMake configuration and cmake/pip templates.  Without
# these the project cannot be built from a fresh clone; the allowlist
# pattern above would otherwise exclude them all.
!CMakeLists.txt
!CMakePresets.json
!*.cmake
!*.cmake.in
!*.py.in
!*.h.in
!*.sh.in

# Repo essentials that the allowlist would otherwise exclude
!.gitignore
!README.md
!install
!run_portal

# Example entry points.  These are extensionless executables, so the allowlist
# above excluded every one of them and no example was runnable from a fresh
# clone.
#
# Neither workflow.yaml nor FW_config.yaml is listed: FireWorks and
# `modena fw run --script` generate both on demand, so a committed copy is
# stale the moment anything changes.  `workflow` (no extension) below is the
# hand-written entry point and IS tracked.
!initModels
!buildModels
!workflow
!rerunSimulations
!Makefile


# Exclude
CLAUDE.md
.claude/
build/
site/
func_*/
launcher_*/
modena.log
models/

CMakeUserPresets.json
