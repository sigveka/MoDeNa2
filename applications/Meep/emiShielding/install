#!/usr/bin/env python3
"""Install the surface impedance chain (dielectricFunction → emiShielding)."""

import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
APPS = HERE.parent.parent

subprocess.run(
    [sys.executable, '-m', 'modena', 'install',
     str(APPS / 'QuantumEspresso/dielectricFunction'),
     str(HERE),
     ],
    check=True,
)
