#!@Python3_EXECUTABLE@
"""Console entry point for the ``modena`` command.

Generated by CMake from ``src/python/modena.py.in`` -- do not edit the
installed copy.

``setup.py.in`` declares this as a ``console_scripts`` entry point, but the
package is installed by copying its ``.py`` files straight into site-packages
(see the ``install(FILES ...)`` rules in ``src/python/CMakeLists.txt``) rather
than by running ``setup.py``.  Nothing therefore ever reads ``console_scripts``,
and the wrapper pip would have generated never existed -- which is why
``modena`` was not on PATH while ``modena-portal``, which really is
pip-installed, was.  This template is that missing wrapper.

The shebang is pinned to the interpreter CMake configured against, matching
what pip does, so the command uses the same Python the package was installed
for.
"""

import sys

from modena.__main__ import _main

if __name__ == '__main__':
    sys.exit(_main())
