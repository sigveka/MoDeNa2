# Generated by CMake from modena-env.sh.in -- do not edit.
#
# Puts this MoDeNa installation on the shell's search paths:
#
#     source @CMAKE_INSTALL_PREFIX@/share/modena/modena-env.sh
#
# Safe to source repeatedly, and safe to add to ~/.bashrc or ~/.profile.
# Every path below was resolved by CMake at install time, so this file and
# the installed tree cannot disagree.

# _modena_prepend VAR DIR -- prepend DIR to VAR unless it is already there.
# Skips directories that do not exist, so an optional component that was not
# built does not leave a dangling entry behind.
_modena_prepend() {
    [ -d "$2" ] || return 0
    eval "_md_cur=\${$1-}"
    case ":${_md_cur}:" in
        *":$2:"*) unset _md_cur; return 0 ;;
    esac
    if [ -n "${_md_cur}" ]; then
        eval "export $1=\"\$2:\${_md_cur}\""
    else
        eval "export $1=\"\$2\""
    fi
    unset _md_cur
}

# Shared libraries -- libmodena, and the Fortran wrappers when built.  Each
# carries RUNPATH=$ORIGIN so it finds its siblings; this entry is what lets an
# application that links against libmodena find libmodena itself.
_modena_prepend LD_LIBRARY_PATH "@MODENA_ENV_LIB_DIR@"

# The modena Python package.  Redundant for the default $HOME install, where
# this is the user site-packages directory Python adds by itself -- but needed
# for a custom prefix, and inside a virtualenv, where user site-packages is
# dropped from sys.path.
_modena_prepend PYTHONPATH "@PYTHON_SITE@"

# The modena command-line entry point.
_modena_prepend PATH "@CMAKE_INSTALL_PREFIX@/bin"

# Read by the MATLAB/Octave gateway to locate the .m sources.
export MODENA_MATLAB_DIR="@CMAKE_INSTALL_PREFIX@/share/modena/matlab"

# Read by the R wrapper to locate libmodena without shelling out to Python.
export MODENA_LIB_DIR="@MODENA_ENV_LIB_DIR@"

unset -f _modena_prepend
