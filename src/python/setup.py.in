#!/usr/bin/env python

from setuptools import setup

import sys

args = {
    'name'        : 'modena',
    'description' : 'Simulation framework application facilitating simulation of interconnected models',
    'version'     : '${PROJECT_VERSION}',
    'package_dir' : { 'modena': '${CMAKE_CURRENT_SOURCE_DIR}' },
    'packages'    : ['modena'],
    'install_requires': (
        ['tomli', 'pydantic>=2.0', 'mongoengine', 'fireworks', 'scipy', 'jinja2'] if sys.version_info < (3, 11)
        else ['pydantic>=2.0', 'mongoengine', 'fireworks', 'scipy', 'jinja2']
    ),
    # Valid trove classifiers (pypi.org/classifiers); the previous ones were
    # all invented.  Both licenses: the core modules are LGPL-3.0-or-later,
    # the rest GPL-3.0-or-later -- see the License section of the README.
    'classifiers' : [
        "License :: OSI Approved :: GNU Lesser General Public License v3 or later (LGPLv3+)",
        "License :: OSI Approved :: GNU General Public License v3 or later (GPLv3+)",
        "Programming Language :: Python :: 3",
        "Programming Language :: C",
        "Programming Language :: Fortran",
        "Development Status :: 4 - Beta",
        "Intended Audience :: Science/Research",
        "Topic :: Scientific/Engineering",
    ],
    'python_requires': '>=3.10',
    'keywords'    : 'multi-scale modelling',
    'entry_points': {
        'console_scripts': [
            'modena = modena.__main__:_main',
        ],
    },
} # end ARGS

if not '${INSTALL_LIB_DIR}' == '':
    args['package_data'] = {'modena': ['${INSTALL_LIB_DIR}/modena']}

setup(**args)
