#!/usr/bin/env python3
"""
@file
Validation workflow for the N2/O2/Ar mixture viscosity surrogate.

Evaluates the trained surrogate at a held-out composition grid and reports
the maximum and mean relative errors versus CoolProp reference values.

@author    MoDeNa Project
@copyright 2014-2026, MoDeNa Project. GNU Public License.
"""

import modena
import coolPropMixture  # noqa: F401
from coolPropMixture import MixtureViscosityValidationTask
from fireworks import Firework, Workflow

wf = Workflow(
    [Firework(
        MixtureViscosityValidationTask(),
        name='validate mixtureViscosity[fluid=N2O2Ar]',
    )],
    name='coolPropMixture validation',
)
modena.run(wf)
print("Workflow complete.")
