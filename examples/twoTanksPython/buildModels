#!/bin/bash
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - #
# @brief  Install Python packages for the pure-Python twoTanksPython example.
#
# Each model uses scikit-build-core (twoTankPython) or setuptools (flowRate) as
# its build backend (pyproject.toml at the model root).  A single "modena install"
# call installs the package under INSTALL_DIR and registers that prefix in
# ~/.modena/config.toml for auto-discovery.
#
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - #

MODENA_MODELS=("flowRate" "twoTankPython")
MODENA_MODELS_DIR="../MoDeNaModels"

BUILD_DIR="${PWD}/build"
INSTALL_DIR="${PWD}/models"

echo "Compiling and installing ${#MODENA_MODELS[@]} models"

for MODEL in "${MODENA_MODELS[@]}"; do
  echo ""
  echo "=== ${MODEL} ==="
  SKBUILD_BUILD_DIR="${BUILD_DIR}/${MODEL}" \
    python3 -m modena install --prefix "${INSTALL_DIR}" \
        "${MODENA_MODELS_DIR}/${MODEL}"
done
