#!/bin/sh
# Generated by CMake — do not edit.
# Launches twoTanksMacroscopicProblemMatlab.m via Octave or MATLAB.
#
# The script adds the Modena MATLAB/Octave wrapper directory to the path so
# that Modena.m and modena_gateway.mex/.mexa64 are found, then runs the .m
# script non-interactively.

MODENA_MATLAB_DIR="@MATLAB_PKG_DIR@"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SCRIPT="$SCRIPT_DIR/twoTanksMacroscopicProblemMatlab.m"

if command -v octave >/dev/null 2>&1; then
    exec octave --no-gui \
         --path "$MODENA_MATLAB_DIR" \
         --path "$SCRIPT_DIR" \
         "$SCRIPT"
elif command -v matlab >/dev/null 2>&1; then
    exec matlab -nodisplay -nosplash -nodesktop \
         -r "addpath('$MODENA_MATLAB_DIR'); addpath('$SCRIPT_DIR'); \
             twoTanksMacroscopicProblemMatlab; exit"
else
    echo "Error: neither Octave nor MATLAB found in PATH." >&2
    exit 1
fi
