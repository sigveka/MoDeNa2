#!/bin/bash
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - #
# @brief  Build binaries and install Python packages for twoTanksChained models.
#
# Models are installed in dependency order: idealGas first (no binary), then
# flowRate_idealGas and twoTankChained (both have compiled C binaries).
#
# Each model uses scikit-build-core as its build backend (pyproject.toml at the
# model root).  A single "modena install" call installs the package and registers the prefix
# in ~/.modena/config.toml for auto-discovery.
#
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - #

MODENA_MODELS=("idealGas" "flowRate_idealGas" "twoTankChained")
MODENA_MODELS_DIR="../MoDeNaModels"

BUILD_DIR="${PWD}/build"
INSTALL_DIR="${PWD}/models"

echo "Compiling and Installing ${#MODENA_MODELS[@]} models"

for MODEL in "${MODENA_MODELS[@]}"; do
  echo ""
  echo "=== ${MODEL} ==="
  SKBUILD_BUILD_DIR="${BUILD_DIR}/${MODEL}" \
    python3 -m modena install --prefix "${INSTALL_DIR}" \
        "${MODENA_MODELS_DIR}/${MODEL}"
done
