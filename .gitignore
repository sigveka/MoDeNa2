# Exclude all files by default
**/*
# Include all directories and Explicitly include relevant file-types
!**/

# Scripting languages
!*.py
!*.m
!*.rb
!*.mat
!*.jl
!*.R
!*.r

# Misc
!*.svg
!*.gp
!*.gpl

# Compiled programming languages
!*.c
!*.h
!*.cpp
!*.C
!*.hpp
!*.H
!*.f
!*.F
!*.f90
!*.F90

# Document markup files
!*.md

# MkDocs and CI configuration
!mkdocs.yml
!.github/workflows/*.yml
!*.toml
# !*.txt
# !*.tex
# !*.bib
# !*.sty
# !*.cls
#

# Build system — CMake configuration and cmake/pip templates.  Without
# these the project cannot be built from a fresh clone; the allowlist
# pattern above would otherwise exclude them all.
!CMakeLists.txt
!CMakePresets.json
!*.cmake
!*.cmake.in
!*.py.in
!*.h.in
!*.sh.in

# Repo essentials that the allowlist would otherwise exclude
!.gitignore
!README.md
!install
!run_portal

# Example entry points.  These are extensionless executables and a hand-written
# FireWorks workflow, so the allowlist above excluded every one of them and no
# example was runnable from a fresh clone.  FW_config.yaml is deliberately NOT
# listed: `modena init` regenerates it on demand.
!initModels
!buildModels
!workflow
!rerunSimulations
!Makefile
!workflow.yaml


# Exclude
CLAUDE.md
.claude/
build/
site/
func_*/
launcher_*/
modena.log
models/

CMakeUserPresets.json
