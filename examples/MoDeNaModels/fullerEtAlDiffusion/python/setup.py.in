#!/usr/bin/env python

from setuptools import setup

args = {
    'name'         : '${CMAKE_PROJECT_NAME}',
    'version'      : '${CMAKE_PROJECT_VERSION}',
    'install_requires': ['modena'],
    'packages'     : ['${CMAKE_PROJECT_NAME}'],
    'package_dir'  : {'${CMAKE_PROJECT_NAME}': '${CMAKE_CURRENT_SOURCE_DIR}'},
    'classifiers'  : [
        "Intended Audience :: Science and Engineering",
        "Topic :: Multi-scale Modelling",
    ],
    'license' : "GNU - General Public License (GPL)",
    'keywords': 'multi-scale modelling',
} # end ARGS


setup(**args)
