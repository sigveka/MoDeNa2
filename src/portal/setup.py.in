#!/usr/bin/env python

from setuptools import setup

args = {
    'name'        : 'modena_portal',
    'description' : 'Web portal for viewing, documenting and evaluating MoDeNa surrogate models',
    'version'     : '${PROJECT_VERSION}',
    'package_dir' : { 'modena_portal': '${CMAKE_CURRENT_SOURCE_DIR}' },
    'packages'    : [
        'modena_portal',
        'modena_portal.pages',
        'modena_portal.components',
        'modena_portal.data',
        'modena_portal.callbacks',
    ],
    'package_data': {
        'modena_portal': ['assets/*.css'],
    },
    'install_requires': [
        'dash>=2.7.0',
        'dash-bootstrap-components>=1.4.0',
        'dash-cytoscape>=0.3.0',
        'plotly>=5.0.0',
    ],
    'extras_require': {
        'production': ['gunicorn>=21.0.0'],
    },
    'entry_points': {
        'console_scripts': [
            'modena-portal = modena_portal.run:main',
        ],
    },
    # Valid trove classifiers (pypi.org/classifiers); the previous ones were
    # all invented, which PyPI rejects.  GPL: see the License section of the
    # top-level README.
    'classifiers': [
        'License :: OSI Approved :: GNU General Public License v3 or later (GPLv3+)',
        'Programming Language :: Python :: 3',
        'Development Status :: 4 - Beta',
        'Intended Audience :: Science/Research',
        'Topic :: Scientific/Engineering',
    ],
    'python_requires': '>=3.10',
    'keywords': 'multi-scale modelling surrogate model portal',
}

setup(**args)
